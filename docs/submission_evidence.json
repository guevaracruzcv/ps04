      "sample_only": true,
      "complete_original_assets_included": false,
      "claim_sample": {
        "claim_id": "01-c1",
        "statement": "The World Bank argues that, in many developing economies, the policy opportunity is to extend scarce expertise, while warning that control of advanced models and infrastructure is concentrated.",
        "type": "source_claim",
        "evidence": [
          {
            "item_id": "feed:48f774f0bb11de5c34ef",
            "version_id": "293f5c7caf77f87f5aedea357a654b5b9cae5329ca5d98b9fd7ba3d6c2a6cb3c",
            "locator": {
              "type": "text",
              "quote": "In much of the developing world, the problem is too few skilled workers, not too many — too few doctors to diagnose disease, too few agronomists to advise farmers, too few officials to deliver services."
            }
          },
          {
            "item_id": "feed:48f774f0bb11de5c34ef",
            "version_id": "293f5c7caf77f87f5aedea357a654b5b9cae5329ca5d98b9fd7ba3d6c2a6cb3c",
            "locator": {
              "type": "text",
              "quote": "A few companies in a few economies control the most advanced AI models, the chips they depend on, and the data centers that run them."
            }
          }
        ]
      }
    },
